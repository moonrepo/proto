---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
function proto_activate {
  $previousExitCode = $global:LASTEXITCODE;
  $exports = proto activate pwsh --export;
  if ($exports) {
    $exports | Out-String | Invoke-Expression;
  }
  $global:LASTEXITCODE = $previousExitCode;
}

function proto_deactivate {
  $exports = proto deactivate pwsh --export;
  if ($exports) {
    $exports | Out-String | Invoke-Expression;
  }

  if (Get-Variable -Name 'proto_activate_handler' -Scope Global -ErrorAction Ignore) {
    $ExecutionContext.SessionState.InvokeCommand.LocationChangedAction = [System.Delegate]::Remove(
      $ExecutionContext.SessionState.InvokeCommand.LocationChangedAction,
      $global:proto_activate_handler
    );
    Remove-Variable -Name 'proto_activate_handler' -Scope Global;
  }

  if (Get-Variable -Name 'proto_activate_prompt' -Scope Global -ErrorAction Ignore) {
    Set-Item -Path 'function:global:prompt' -Value $global:proto_activate_prompt;
    Remove-Variable -Name 'proto_activate_prompt' -Scope Global;
  }

  Remove-Item -LiteralPath 'function:proto_activate' -ErrorAction Ignore;
  Remove-Item -LiteralPath 'function:proto_deactivate' -ErrorAction Ignore;
}

if (-not (Get-Variable -Name 'proto_activate_handler' -Scope Global -ErrorAction Ignore)) {
  $global:proto_activate_handler = [System.EventHandler[System.Management.Automation.LocationChangedEventArgs]] {
    param([object] $source, [System.Management.Automation.LocationChangedEventArgs] $changedArgs)
    end {
      proto_activate
    }
  };

  $ExecutionContext.SessionState.InvokeCommand.LocationChangedAction = [System.Delegate]::Combine(
    $ExecutionContext.SessionState.InvokeCommand.LocationChangedAction,
    $global:proto_activate_handler
  );
};

if (-not (Get-Variable -Name 'proto_activate_prompt' -Scope Global -ErrorAction Ignore)) {
  $global:proto_activate_prompt = $function:prompt;

  function global:prompt {
    proto_activate;
    & $global:proto_activate_prompt;
  }
};

proto_activate
