---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
_proto_activate_hook() {
  local previous_exit_status=$?;
  local output;
  trap '' SIGINT;
  output=$(proto activate bash --config-mode upwards-global --no-bin --no-shim --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  trap - SIGINT;
  return $previous_exit_status;
};

_proto_deactivate_hook() {
  local output;
  output=$(proto deactivate bash --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
    local filtered=();
    local entry;
    for entry in "${PROMPT_COMMAND[@]}"; do
      if [[ "$entry" != "_proto_activate_hook" ]]; then
        filtered+=("$entry");
      fi
    done
    PROMPT_COMMAND=("${filtered[@]}");
  else
    PROMPT_COMMAND=";${PROMPT_COMMAND:-};";
    PROMPT_COMMAND="${PROMPT_COMMAND//;_proto_activate_hook;/;}";
    PROMPT_COMMAND="${PROMPT_COMMAND#;}";
    PROMPT_COMMAND="${PROMPT_COMMAND%;}";
  fi
  unset -f _proto_activate_hook _proto_deactivate_hook;
};

if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
  if [[ " ${PROMPT_COMMAND[*]:-} " != *" _proto_activate_hook "* ]]; then
    PROMPT_COMMAND=(_proto_activate_hook "${PROMPT_COMMAND[@]}")
  fi
elif [[ ";${PROMPT_COMMAND:-};" != *";_proto_activate_hook;"* ]]; then
  PROMPT_COMMAND="_proto_activate_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

_proto_activate_hook
