---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
proto_activate() {
  local previous_exit_status=$?;
  local output;
  trap '' SIGINT;
  output=$(proto activate bash --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  trap - SIGINT;
  return $previous_exit_status;
};

proto_deactivate() {
  local output;
  output=$(proto deactivate bash --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
    local filtered=();
    local entry;
    for entry in "${PROMPT_COMMAND[@]}"; do
      if [[ "$entry" != "proto_activate" ]]; then
        filtered+=("$entry");
      fi
    done
    PROMPT_COMMAND=("${filtered[@]}");
  else
    PROMPT_COMMAND=";${PROMPT_COMMAND:-};";
    PROMPT_COMMAND="${PROMPT_COMMAND//;proto_activate;/;}";
    PROMPT_COMMAND="${PROMPT_COMMAND#;}";
    PROMPT_COMMAND="${PROMPT_COMMAND%;}";
  fi
  unset -f proto_activate proto_deactivate;
};

if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
  if [[ " ${PROMPT_COMMAND[*]:-} " != *" proto_activate "* ]]; then
    PROMPT_COMMAND=(proto_activate "${PROMPT_COMMAND[@]}")
  fi
elif [[ ";${PROMPT_COMMAND:-};" != *";proto_activate;"* ]]; then
  PROMPT_COMMAND="proto_activate${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
