---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
function proto_activate {
  proto activate murex --config-mode upwards-global --no-bin --no-shim --export -> source
}
function proto_deactivate {
  proto deactivate murex --export -> source
}
event onPrompt proto_activate_on_prompt=before {
  proto_activate
}

proto_activate
