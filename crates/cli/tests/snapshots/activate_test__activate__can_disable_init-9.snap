---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
function proto_activate {
  $previousExitCode = $global:LASTEXITCODE;
  $exports = proto activate powershell --export;
  if ($exports) {
    $exports | Out-String | Invoke-Expression;
  }
  $global:LASTEXITCODE = $previousExitCode;
}
function proto_deactivate {
  $previousExitCode = $global:LASTEXITCODE;
  $exports = proto deactivate powershell --export;
  if ($exports) {
    $exports | Out-String | Invoke-Expression;
  }
  $global:LASTEXITCODE = $previousExitCode;
}
# Windows PowerShell has no change-dir trigger, since `LocationChangedAction`
# requires PowerShell 6+, so the global prompt is wrapped instead
if (-not (Get-Variable -Name 'proto_activate_on_prompt' -Scope Global -ErrorAction Ignore)) {
  $global:proto_activate_on_prompt = $function:prompt;

  function global:prompt {
    proto_activate;
    & $global:proto_activate_on_prompt;
  }
};
