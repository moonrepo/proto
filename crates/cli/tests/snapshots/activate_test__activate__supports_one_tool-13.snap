---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
proto-activate() {
  local output
  trap '' SIGINT
  output=$(proto activate zsh --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  trap - SIGINT
}

proto-deactivate() {
  local output
  output=$(proto deactivate zsh --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  chpwd_functions=(${chpwd_functions:#proto-activate})
  unfunction proto-activate proto-deactivate 2>/dev/null
}

typeset -ag chpwd_functions
if (( ! ${chpwd_functions[(I)proto-activate]} )); then
  chpwd_functions=(proto-activate $chpwd_functions)
fi

proto-activate
