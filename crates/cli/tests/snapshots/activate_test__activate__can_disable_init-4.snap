---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
fn _proto_activate_hook {|@_|
  eval (proto activate elvish --export | slurp)
}

fn _proto_deactivate_hook {
  eval (proto deactivate elvish --export | slurp)
  set after-chdir = [(each {|hook| if (not (and (has-key $hook def) (eq $hook[def] $_proto_activate_hook~[def]))) { put $hook } } $after-chdir)]
}

set after-chdir = [(each {|hook| if (not (and (has-key $hook def) (eq $hook[def] $_proto_activate_hook~[def]))) { put $hook } } $after-chdir)]
set @after-chdir = $@after-chdir $_proto_activate_hook~
