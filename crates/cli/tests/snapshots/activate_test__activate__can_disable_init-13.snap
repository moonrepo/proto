---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---
proto_activate() {
  local output
  trap '' SIGINT
  output=$(proto activate zsh --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  trap - SIGINT
}

proto_deactivate() {
  local output
  output=$(proto deactivate zsh --export)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  chpwd_functions=(${chpwd_functions:#proto_activate})
  precmd_functions=(${precmd_functions:#proto_activate})
  unfunction proto_activate proto_deactivate 2>/dev/null
}

typeset -ag chpwd_functions
if (( ! ${chpwd_functions[(I)proto_activate]} )); then
  chpwd_functions=(proto_activate $chpwd_functions)
fi

typeset -ag precmd_functions
if (( ! ${precmd_functions[(I)proto_activate]} )); then
  precmd_functions=(proto_activate $precmd_functions)
fi
