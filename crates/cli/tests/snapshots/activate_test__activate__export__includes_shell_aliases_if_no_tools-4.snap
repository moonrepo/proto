---
source: crates/cli/tests/activate_test.rs
expression: "get_activate_output(&assert, &sandbox)"
---

unset-env PROTO_VERSION;
set-env _PROTO_ACTIVATED_PATH '<WORKSPACE>/.proto/shims:<WORKSPACE>/.proto/bin';
try { edit:add-vars [&'..~'={|@_| cd .. $@_ }] } catch _ { }
try { edit:add-vars [&'gs~'={|@_| git status $@_ }] } catch _ { }
set-env _PROTO_ACTIVATED_ALIASES '..,gs';
